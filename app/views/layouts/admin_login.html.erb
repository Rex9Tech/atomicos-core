<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title><%= content_for?(:title) ? yield(:title) : "Sign in" %> · AtomicOS Admin</title>
    <%= csrf_meta_tags %>
    <style>
      /* AtomicOS Admin — sign-in surface (self-contained; no asset pipeline deps) */
      :root {
        --ao-green: #22C55E;
        --ao-green-light: #34D399;
        --ao-green-soft: rgba(34, 197, 94, 0.16);
        --ao-bg: #0A1710;
        --ao-card-top: rgba(20, 48, 32, 0.92);
        --ao-card-bot: rgba(10, 24, 16, 0.96);
        --ao-border: rgba(52, 211, 153, 0.18);
        --ao-input-border: #23412E;
        --ao-text: #EAF6EE;
        --ao-text-muted: #98B5A0;
        --ao-text-dim: #6E8A78;
      }

      * { box-sizing: border-box; }

      html, body { height: 100%; }

      body {
        margin: 0;
        padding: 28px 16px;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: var(--ao-bg);
        color: var(--ao-text);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", "Helvetica Neue", Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
        position: relative;
        overflow-x: hidden;
      }

      .glow {
        position: fixed;
        border-radius: 50%;
        filter: blur(90px);
        pointer-events: none;
        z-index: 0;
      }
      .glow--top {
        width: 540px; height: 540px;
        top: -220px; right: -140px;
        background: radial-gradient(circle, rgba(34, 197, 94, 0.20), transparent 65%);
      }
      .glow--bottom {
        width: 620px; height: 620px;
        bottom: -300px; left: -180px;
        background: radial-gradient(circle, rgba(20, 83, 45, 0.55), transparent 65%);
      }

      .shell {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 420px;
      }

      .card {
        position: relative;
        overflow: hidden;
        border-radius: 22px;
        padding: 40px 36px 26px;
        background: linear-gradient(165deg, var(--ao-card-top), var(--ao-card-bot));
        border: 1px solid var(--ao-border);
        box-shadow:
          0 30px 80px rgba(0, 0, 0, 0.55),
          0 1px 0 rgba(255, 255, 255, 0.06) inset;
        backdrop-filter: blur(14px);
        animation: rise 0.45s ease both;
      }
      .card::before {
        content: "";
        position: absolute;
        top: 0; left: 12%; right: 12%;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(52, 211, 153, 0.6), transparent);
      }

      @keyframes rise {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: none; }
      }

      .brand {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 12px;
        margin-bottom: 26px;
      }
      .brand .mark { width: 54px; height: 54px; }
      .wordmark {
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.1;
      }
      .wordmark em { color: var(--ao-green); font-style: normal; }
      .tagline {
        margin-top: 4px;
        font-size: 11.5px;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--ao-text-muted);
      }

      .alert {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 18px;
        padding: 11px 13px;
        border-radius: 12px;
        font-size: 13.5px;
        background: rgba(239, 68, 68, 0.10);
        border: 1px solid rgba(239, 68, 68, 0.35);
        color: #FCA5A5;
      }
      .alert-dot {
        flex: none;
        width: 7px; height: 7px;
        border-radius: 50%;
        background: #EF4444;
        box-shadow: 0 0 10px rgba(239, 68, 68, 0.8);
      }

      .field { margin-bottom: 16px; }
      .field label {
        display: block;
        margin-bottom: 7px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: #9FBCA9;
      }
      .field input {
        width: 100%;
        padding: 12px 14px;
        border-radius: 12px;
        border: 1px solid var(--ao-input-border);
        background: rgba(5, 15, 10, 0.65);
        color: #F0FAF3;
        font-size: 15px;
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
      }
      .field input::placeholder { color: #5F7A69; }
      .field input:focus {
        border-color: #2FD774;
        background: rgba(7, 20, 13, 0.85);
        box-shadow: 0 0 0 3px var(--ao-green-soft);
      }

      .pw { position: relative; }
      .pw input { padding-right: 70px; }
      .pw-toggle {
        position: absolute;
        top: 50%;
        right: 8px;
        transform: translateY(-50%);
        padding: 6px 9px;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: #8FB89E;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
        cursor: pointer;
        transition: color 0.15s ease, background 0.15s ease;
      }
      .pw-toggle:hover { color: #34E58A; background: rgba(34, 197, 94, 0.08); }

      .submit {
        width: 100%;
        margin-top: 8px;
        padding: 13px 16px;
        border: 0;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 0.01em;
        color: #04170C;
        cursor: pointer;
        background: linear-gradient(180deg, #31DA74, #1FAE57);
        box-shadow: 0 10px 26px rgba(34, 197, 94, 0.28);
        transition: filter 0.15s ease, box-shadow 0.15s ease, transform 0.12s ease;
      }
      .submit:hover {
        filter: brightness(1.06);
        box-shadow: 0 12px 30px rgba(34, 197, 94, 0.36);
      }
      .submit:active { transform: translateY(1px); }
      .submit:focus-visible { outline: 3px solid rgba(34, 197, 94, 0.35); outline-offset: 2px; }

      .foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-top: 24px;
        padding-top: 16px;
        border-top: 1px solid rgba(52, 211, 153, 0.10);
        font-size: 12px;
        color: var(--ao-text-dim);
      }
      .chip {
        flex: none;
        padding: 3px 10px;
        border-radius: 999px;
        border: 1px solid rgba(52, 211, 153, 0.28);
        background: rgba(34, 197, 94, 0.07);
        color: var(--ao-green-light);
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      @media (max-width: 480px) {
        .card { padding: 30px 20px 22px; border-radius: 18px; }
        .wordmark { font-size: 23px; }
      }

      @media (prefers-reduced-motion: reduce) {
        * { animation: none !important; transition: none !important; }
      }
    </style>
  </head>
  <body>
    <div class="glow glow--top" aria-hidden="true"></div>
    <div class="glow glow--bottom" aria-hidden="true"></div>
    <main class="shell">
      <%= yield %>
    </main>
  </body>
</html>
